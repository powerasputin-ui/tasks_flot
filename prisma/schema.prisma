// ГШП Оперативка — Prisma schema (ТЗ v4, TZ_v4.md).
// Этап 1: роли, единая позиция оперативки (OperationalItem), журнал. Подразделений в системе нет.
// Циклы оперативки, отправка по позициям и финальные снимки — этап 3-4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HEAD // Руководитель направления: заполняет свои позиции
  DIRECTOR // Директор дирекции: правит всё в своей дирекции, собирает и отправляет итог ЗГД
  EXECUTIVE    @map("MANAGEMENT") // ЗГД: видит отправленные итоги дирекций
  ADMIN        @map("CURATOR") // Админ (бывший первичный куратор): заводит дирекции и людей, назначает директоров
  SYSTEM_ADMIN // Технический администратор
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean      @default(true)
  sessionsValidAfter DateTime? // сессии, выданные раньше, недействительны (смена пароля/отключение/роли)
  memoEditor         Boolean      @default(false) // составитель справки для ЗГД (назначает админ; директор и админ ведут справку по роли)
  submits            Boolean      @default(false) // админ/директор, который ещё и подаёт свои позиции как руководитель (у руководителя — всегда)
  tableColumns       Json? // личные настройки колонок таблицы (порядок, видимость, ширина, подписи)
  directorateId      String? // дирекция человека (пусто у ЗГД; у админа — «домашняя», рабочую он выбирает сам)
  directorate        Directorate? @relation(fields: [directorateId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  responsibleItems OperationalItem[] @relation("ItemResponsible")
  createdItems     OperationalItem[] @relation("ItemCreatedBy")
  updatedItems     OperationalItem[] @relation("ItemUpdatedBy")
  notes            ItemNote[]
  auditEvents      AuditEvent[]
  notifications    Notification[]
  reportTemplates  ReportTemplate[]

  @@map("users")
}

model Segment {
  id            String       @id @default(cuid())
  name          String
  directorateId String?
  directorate   Directorate? @relation(fields: [directorateId], references: [id])
  color         String?
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tracks Track[]
  items  OperationalItem[]

  @@unique([directorateId, name])
  @@map("segments")
}

model Attractiveness {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OperationalItem[]

  @@map("attractiveness")
}

model Status {
  id            String         @id @default(cuid())
  name          String         @unique
  sortOrder     Int            @default(0)
  color         String?
  isActive      Boolean        @default(true)
  /// Колонка «Трекера» (Сделать / В работе / На проверке / Выполнено / не показывать); пусто — «Сделать».
  trackerColumn TrackerColumn?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items OperationalItem[]

  @@map("statuses")
}

enum TrackerColumn {
  TODO
  DOING
  REVIEW
  DONE
  HIDDEN
}

// Справочник (раньше Track был рабочей сущностью). Не удаляется физически (isActive=false).
model Track {
  id            String       @id @default(cuid())
  name          String
  segmentId     String?
  segment       Segment?     @relation(fields: [segmentId], references: [id])
  directorateId String?
  directorate   Directorate? @relation(fields: [directorateId], references: [id])
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         OperationalItem[]
  memoSection   MemoSection?      @relation(fields: [memoSectionId], references: [id], onDelete: SetNull)
  memoSectionId String?

  @@unique([segmentId, name])
  @@map("tracks")
}

/// Единая позиция оперативки (раздел 3 TZ_v4). Живёт постоянно; удаление = архивирование (archivedAt).
/// version — оптимистическая блокировка (409 при конфликте).
model OperationalItem {
  id               String          @id @default(cuid())
  segmentId        String?
  segment          Segment?        @relation(fields: [segmentId], references: [id])
  trackId          String?
  track            Track?          @relation(fields: [trackId], references: [id])
  title            String
  cost             String? // свободный текст ("2 млн.$")
  attractivenessId String?
  attractiveness   Attractiveness? @relation(fields: [attractivenessId], references: [id])
  responsibleId    String?
  responsible      User?           @relation("ItemResponsible", fields: [responsibleId], references: [id])
  deadline         DateTime?
  statusId         String?
  status           Status?         @relation(fields: [statusId], references: [id])
  comment          String?
  operFlag         Boolean         @default(false) // «Опер» = отправлено куратору
  createdById      String
  createdBy        User            @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        User?           @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime?
  version          Int             @default(1)
  customValues     Json            @default("{}") // значения своих колонок: { <id колонки>: "значение" }
  files            Json            @default("[]") // ссылки на файлы на общем диске: [{ id, path, name }] (сами файлы не грузим)
  directorateId    String?
  directorate      Directorate?    @relation(fields: [directorateId], references: [id])
  /// Поручение (трекер): какой результат ожидается — по нему директор принимает работу.
  expectedResult   String?
  /// Срок, поставленный впервые: не меняется при переносах (видно, сорвали ли исходное обязательство).
  originalDeadline DateTime?
  /// Блокер: на чём ждём и до какой даты ожидаем (не статус, а отдельное поле — сигнал «Блокер»).
  blockedBy        String?
  blockedUntil     DateTime?
  /// Отменена / неактуальна: причина (кто и когда — в журнале).
  cancelReason     String?
  /// Источник: "ZGD" — поручение ЗГД (кто дал и когда).
  origin           String?
  assignedById     String?
  assignedByName   String?
  assignedAt       DateTime?
  /// ЗГД взял на контроль: перенос срока — только с согласия директора, ЗГД получает подтверждённые изменения.
  zgdControl       Boolean         @default(false)
  /// Когда директор последний раз подтвердил состояние для ЗГД.
  publishedAt      DateTime?

  notes            ItemNote[]
  reviews          TaskReview[]
  publications     ItemPublication[]
  zgdRequests      ZgdRequest[]
  deadlineRequests DeadlineRequest[]

  @@index([segmentId])
  @@index([trackId])
  @@index([statusId])
  @@index([responsibleId])
  @@index([deadline])
  @@index([archivedAt])
  @@index([directorateId])
  @@map("operational_items")
}

/// Замечание куратора к позиции (необязательно; свой текст с автором).
model ItemNote {
  id        String          @id @default(cuid())
  itemId    String
  item      OperationalItem @relation(fields: [itemId], references: [id])
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  text      String
  /// Кто видит: INTERNAL — дирекция (комментарии, замечания при возврате); ZGD — ещё и ЗГД (ответ директора на его комментарий).
  audience  String          @default("INTERNAL")
  createdAt DateTime        @default(now())

  @@index([itemId])
  @@map("item_notes")
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DEADLINE_CHANGE
  OWNER_CHANGE
  ATTRACTIVENESS_CHANGE
  OPER_FLAG_CHANGE
  ARCHIVE
  RESTORE
}

/// Append-only журнал: одно событие на изменённое поле (кто, что, было → стало).
model AuditEvent {
  id              String      @id @default(cuid())
  entityType      String // "OperationalItem" (и др. в будущем)
  entityId        String
  actorId         String?
  actor           User?       @relation(fields: [actorId], references: [id])
  action          AuditAction
  timestamp       DateTime    @default(now())
  fieldName       String?
  before          String?
  after           String?
  afterSubmission Boolean     @default(false) // правка сделана после отправки куратору

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_events")
}

enum NotificationType {
  MENTION
  WEEKLY_UPDATE_DUE
  CHANGE_ATTENTION
  EDIT_REQUEST
  SUBMISSION_MISSING // «ФИО ничего не заполнил и не подал» (этап 3)
  ITEM_RETURNED // куратор вернул позицию на доработку
  ROLE_CHANGED // назначен куратором / снят с кураторства
  MEMO_SENT // директор отправил справку ЗГД
  MEMO_RETURNED // ЗГД вернул справку директору
  DEADLINE_SOON // через 2 дня срок позиции (ответственному)
  DEADLINE_OVERDUE // срок позиции прошёл (ответственному; сводка — директору и админу)
  REVIEW_SUBMITTED // задачу сдали на проверку (директору)
  REVIEW_DECIDED // директор принял / вернул (сдавшему)
  ZGD_REQUEST // ЗГД запросил статус (директору)
  ZGD_ANSWER // директор ответил на запрос (ЗГД)
  ZGD_ORDER // поручение ЗГД (директору)
  ZGD_COMMENT // комментарий ЗГД к задаче (директору и ответственному)
  DEADLINE_REQUEST // запрос / решение по переносу срока
  ZGD_UPDATE // подтверждённое изменение задачи на контроле (ЗГД)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum CycleStatus {
  OPEN // сбор: руководители отмечают «Опер»
  IN_REVIEW // сборка: куратор проверяет, правит, возвращает
  FINAL // зафиксирован снимок, цикл неизменяем
}

/// Цикл оперативки (один недельный период; активен не более одного).
/// snapshot — неизменяемый снимок отправленных позиций на момент финализации.
model Cycle {
  id              String        @id @default(cuid())
  number          Int
  directorateId   String?
  directorate     Directorate?  @relation(fields: [directorateId], references: [id])
  deadline        DateTime // срок подачи; за 2 дня до него куратору приходит напоминание «не подал»
  status          CycleStatus   @default(OPEN)
  createdById     String
  createdAt       DateTime      @default(now())
  reviewStartedAt DateTime?
  finalizedAt     DateTime?
  finalizedById   String?
  remindersSentAt DateTime?
  snapshot        Json?
  meetingDate     DateTime? // дата оперативного совещания («к ОС …» в заголовке справки)
  memoDraft       Json? // черновик справки директора (см. lib/memo.ts)
  memoVersion     Int           @default(0) // растёт при каждом сохранении черновика (защита от одновременной правки)
  revision        Int           @default(1) // ревизия справки: растёт, когда ЗГД возвращает её директору
  versions        MemoVersion[]

  @@unique([directorateId, number])
  @@index([status])
  @@map("cycles")
}

enum CustomColumnType {
  TEXT
  NUMBER
  DATE
  SELECT
}

/// Свои колонки таблицы: создаёт куратор, значения заполняют те, кто правит позицию.
/// Значения хранятся в OperationalItem.customValues по ключу id колонки.
/// Удаление мягкое (isActive=false): значения остаются в истории, колонка скрывается.
model CustomColumn {
  id            String           @id @default(cuid())
  name          String
  type          CustomColumnType @default(TEXT)
  options       String[] // для SELECT
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  directorateId String?
  directorate   Directorate?     @relation(fields: [directorateId], references: [id])

  @@map("custom_columns")
}

/// Общие настройки приложения (ключ → значение). Сейчас: "table.columns" — вид колонок таблицы для всех,
/// его задаёт куратор (порядок, подписи, показ, «удалённые» колонки).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum ReportScope {
  PERSONAL // виден только владельцу
  SHARED // виден всем (создаёт куратор или администратор)
}

/// Сохранённая настройка отчёта «Оперативки»: колонки, группировка, фильтры (см. lib/report-config.ts).
model ReportTemplate {
  id            String       @id @default(cuid())
  name          String
  config        Json
  scope         ReportScope  @default(PERSONAL)
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])
  directorateId String? // общие шаблоны принадлежат дирекции
  directorate   Directorate? @relation(fields: [directorateId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId])
  @@map("report_templates")
}

/// Дирекция: у каждой свои люди, позиции, сегменты, треки, циклы и колонки. Статусы и привлекательность общие.
model Directorate {
  id         String   @id @default(cuid())
  name       String   @unique
  shortName  String? // короткое название для заголовка справки («РФ и КЭ»)
  memoConfig Json? // вид справки: группировка разделов и поля таблицы в тексте пункта (см. lib/memo.ts)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  users           User[]
  items           OperationalItem[]
  segments        Segment[]
  tracks          Track[]
  cycles          Cycle[]
  customColumns   CustomColumn[]
  reportTemplates ReportTemplate[]
  memoSections    MemoSection[]
  memoVersions    MemoVersion[]

  @@map("directorates")
}

/// Раздел справки («1. Кабелеукладочное направление»): у каждой дирекции свой набор; в него входят треки.
model MemoSection {
  id            String      @id @default(cuid())
  directorateId String
  directorate   Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  title         String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  tracks        Track[]

  @@index([directorateId])
  @@map("memo_sections")
}

/// Отправленная ЗГД версия справки: неизменяемый снимок (текст, строки-источники, участие подачи). Основа архива, поиска и сравнения.
model MemoVersion {
  id             String      @id @default(cuid())
  cycleId        String
  cycle          Cycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  directorateId  String
  directorate    Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  revision       Int
  title          String
  meetingDate    DateTime?
  doc            Json // MemoDoc на момент отправки
  sources        Json // строки-источники пунктов на момент отправки
  participation  Json // кто сколько подал
  rows           Json? // вся таблица дирекции на момент отправки (с пометками «подано» / «в справке»)
  columns        Json? // раскладка на момент отправки: столбцы (названия зафиксированы) и порядок сегментов
  note           String?
  searchText     String // весь текст справки одной строкой — для поиска
  sentById       String
  sentByName     String
  sentAt         DateTime    @default(now())
  returnedAt     DateTime?
  returnComment  String?
  returnedByName String?

  @@unique([cycleId, revision])
  @@index([directorateId, sentAt])
  @@map("memo_versions")
}

/// Подключение ИИ у ЗГД: провайдер, адрес, модель и зашифрованный ключ (наружу ключ не отдаётся никогда).
model AiSetting {
  userId    String   @id
  provider  String // "openai" (OpenAI-совместимый) | "anthropic"
  baseUrl   String
  model     String
  apiKeyEnc String
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

/// Счётчики ограничения частоты запросов (вход, ИИ, напоминания): окно фиксированной длины на ключ.
model RateLimit {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)

  @@map("rate_limits")
}

/// Трекер: сдача задачи на проверку и решение директора (принял / вернул с причиной).
model TaskReview {
  id              String          @id @default(cuid())
  itemId          String
  item            OperationalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  submittedById   String
  submittedByName String
  submittedAt     DateTime        @default(now())
  result          String
  files           Json            @default("[]")
  decision        String? // ACCEPTED | RETURNED
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  comment         String?

  @@index([itemId])
  @@map("task_reviews")
}

/// Подтверждённое директором состояние задачи — то, что видит ЗГД (снимок полей + кто, когда, почему).
model ItemPublication {
  id              String          @id @default(cuid())
  itemId          String
  item            OperationalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  directorateId   String
  publishedAt     DateTime        @default(now())
  publishedById   String
  publishedByName String
  reason          String
  snapshot        Json

  @@index([itemId, publishedAt])
  @@index([directorateId])
  @@map("item_publications")
}

/// Запрос статуса от ЗГД по задаче: идёт директору, ответ директора подтверждает состояние для ЗГД.
model ZgdRequest {
  id             String          @id @default(cuid())
  itemId         String
  item           OperationalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  directorateId  String
  askedById      String
  askedByName    String
  text           String
  dueAt          DateTime?
  createdAt      DateTime        @default(now())
  answer         String?
  answeredById   String?
  answeredByName String?
  answeredAt     DateTime?

  @@index([itemId])
  @@index([directorateId])
  @@map("zgd_requests")
}

/// Запрос на перенос срока (поручение ЗГД или задача на контроле): руководитель просит, директор решает.
model DeadlineRequest {
  id              String          @id @default(cuid())
  itemId          String
  item            OperationalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedByName String
  newDeadline     DateTime
  reason          String
  createdAt       DateTime        @default(now())
  decision        String? // APPROVED | REJECTED | CLOSED (директор сам изменил срок)
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  comment         String?

  @@index([itemId])
  @@map("deadline_requests")
}

/// Личный чат двух человек (1 на 1). Пара хранится в порядке id (userAId < userBId): одна пара — один диалог.
model ChatThread {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  startedById   String
  /// ЗГД уже писал в этом диалоге: после этого руководитель может отвечать (до закрытия диалога ЗГД).
  zgdSpoke      Boolean  @default(false)
  /// ЗГД закрыл диалог: руководитель снова может писать ЗГД только после его нового сообщения.
  closedAt      DateTime?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ChatMessage[]
  reads    ChatRead[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("chat_threads")
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  /// Приложенная задача (ссылка): название видит только тот, кому задача доступна.
  itemId    String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model ChatRead {
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime   @default(now())

  @@id([threadId, userId])
  @@map("chat_reads")
}
