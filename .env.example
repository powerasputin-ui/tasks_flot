# Шаблон переменных окружения: скопируйте в .env и подставьте свои значения
# (bash: cp .env.example .env · PowerShell: Copy-Item .env.example .env). Что без каждой переменной сломается — таблица в README.
# Локально: npm run db:local поднимает встроенный PostgreSQL, адрес — в начале scripts/local-db.mjs.
# На Vercel те же переменные вносятся в Project → Settings → Environment Variables.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# подписывает сессии (JWT); при смене все пользователи выходят
AUTH_SECRET="generate with: openssl rand -base64 32"

# Нужна на Vercel: без неё ежедневный cron (/api/cron/reminders) отвечает 401 — не работают напоминания, сводки и уборка.
CRON_SECRET="generate with: openssl rand -base64 32"

# Необязательно: отдельный ключ шифрования сохранённых ключей ИИ (по умолчанию берётся AUTH_SECRET).
# AI_KEY_SECRET="generate with: openssl rand -base64 32"
